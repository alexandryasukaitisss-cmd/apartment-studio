{
  "name": "apartment-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "apartment-agent": "./server/agent-cli.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "NODE_ENV=production node server/index.mjs",
    "server": "node server/index.mjs",
    "agent": "node server/agent-cli.mjs",
    "test:server": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.6"
  },
  "description": "Local-first 2D/3D floor plan & renovation planner with Smart Layout Audit, 4 renovation stages, wall elevations, cost estimates, and A2UI 1.0 multi-CLI AI assistant (Codex, Claude, OpenCode, Gemini, Ollama).",
